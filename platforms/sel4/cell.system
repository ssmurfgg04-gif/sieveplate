<?xml version="1.0" encoding="UTF-8"?>
<!--
  sieveplate — seL4 Microkit system description (the CI-built one).

  One protection domain hosting the reference cell turn loop: proof that
  this repository builds and BOOTS seL4. The full two-PD mapping (vat PD +
  store PD over endpoint capabilities) is documented in README.md and is
  the port target's next step.
-->
<system>
    <protection_domain name="cell" priority="100" stack_size="0x8000">
        <program_image path="cell.elf" />
    </protection_domain>
</system>
